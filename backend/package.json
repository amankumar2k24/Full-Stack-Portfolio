{
    "name": "aman-portfolio-backend",
    "version": "1.0.0",
    "description": "Backend API for Aman Kumar's portfolio",
    "main": "dist/main.js",
    "scripts": {
        "build": "nest build",
        "start": "node dist/main.js",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "test": "jest",
        "test:watch": "jest --watch",
        "migrate:skills": "npx ts-node src/scripts/migrate-skills.ts",
        "add-order-projects": "ts-node src/scripts/add-order-to-projects.ts",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "jest --config ./test/jest-e2e.json",
        "seed": "ts-node src/seed.ts",
        "update-admin": "ts-node src/update-admin.ts",
        "manage-experience": "ts-node src/scripts/manage-experience.ts",
        "manage-stats": "ts-node src/scripts/manage-stats.ts",
        "seed-stats": "ts-node src/scripts/seed-default-stats.ts",
        "seed-skills": "ts-node src/scripts/seed-default-skills.ts",
        "update-user": "node update-user.js",
        "update-placeholders": "node update-placeholder-images.js"
    },
    "dependencies": {
        "@nestjs/common": "^10.4.20",
        "@nestjs/config": "^3.3.0",
        "@nestjs/core": "^10.4.20",
        "@nestjs/jwt": "^10.2.0",
        "@nestjs/mongoose": "^10.1.0",
        "@nestjs/passport": "^10.0.3",
        "@nestjs/platform-express": "^10.4.20",
        "bcrypt": "^5.1.1",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.2",
        "mongoose": "^7.8.7",
        "passport": "^0.6.0",
        "passport-jwt": "^4.0.1",
        "passport-local": "^1.0.0",
        "reflect-metadata": "^0.1.14",
        "rxjs": "^7.8.2"
    },
    "devDependencies": {
        "@nestjs/cli": "^10.2.1",
        "@nestjs/schematics": "^10.0.3",
        "@nestjs/testing": "^10.2.7",
        "@types/bcrypt": "^5.0.2",
        "@types/express": "^4.17.20",
        "@types/jest": "^29.5.7",
        "@types/node": "^20.19.23",
        "@types/passport-jwt": "^3.0.13",
        "@types/passport-local": "^1.0.38",
        "@types/supertest": "^2.0.15",
        "@typescript-eslint/eslint-plugin": "^6.9.1",
        "@typescript-eslint/parser": "^6.9.1",
        "eslint": "^8.52.0",
        "eslint-config-prettier": "^9.0.0",
        "eslint-plugin-prettier": "^5.0.1",
        "jest": "^29.7.0",
        "prettier": "^3.0.3",
        "source-map-support": "^0.5.21",
        "supertest": "^6.3.3",
        "ts-jest": "^29.1.1",
        "ts-loader": "^9.5.0",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.9.3"
    }
}